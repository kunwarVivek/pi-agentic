{
  "name": "agentic-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": [
    "packages/core",
    "packages/control-plane",
    "packages/extension",
    "packages/deploy",
    "packages/cli"
  ],
  "scripts": {
    "typecheck": "tsc --build && tsc -p tsconfig.tests.json",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "node --conditions development --experimental-strip-types --test 'packages/*/test/**/*.test.ts'",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
