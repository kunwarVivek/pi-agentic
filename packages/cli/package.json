{
  "name": "@agentic-pi/cli",
  "version": "0.1.0",
  "description": "agentic-pi operator CLI (`org`): the human control-host tool for the approval inbox and other operator verbs, speaking to the control plane over its Unix socket with an admin token.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24" },
  "files": ["dist", "src", "!**/*.test.ts"],
  "bin": {
    "org": "./dist/main.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentic-pi/core": "0.1.0",
    "@agentic-pi/control-plane": "0.1.0"
  }
}
