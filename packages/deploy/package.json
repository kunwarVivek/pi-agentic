{
	"name": "pi-agentic-deploy",
	"version": "0.1.0",
	"description": "agentic-pi deployment generators: hardened systemd unit files (one Unix user per unit), bubblewrap sandbox argv from a unit's path grants, and a render CLI that turns a live control.db into installable unit files.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kunwarVivek/pi-agentic.git",
		"directory": "packages/deploy"
	},
	"homepage": "https://github.com/kunwarVivek/pi-agentic#readme",
	"bugs": {
		"url": "https://github.com/kunwarVivek/pi-agentic/issues"
	},
	"keywords": [
		"agentic-pi",
		"systemd",
		"bubblewrap",
		"sandbox"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"org-render": "./dist/render.js"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc --build",
		"typecheck": "tsc --noEmit",
		"prepack": "tsc --build"
	},
	"dependencies": {
		"pi-agentic-core": "0.1.0",
		"pi-agentic-control-plane": "0.1.0"
	}
}
