{
	"name": "pi-agentic-evals",
	"version": "0.1.0",
	"description": "agentic-pi eval runner: run a unit's eval suite (prompt cases checked against gate contracts) with an injectable solver, then record the pass rate through the control plane so FR8 lifecycle can deprecate under-performing units.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kunwarVivek/pi-agentic.git",
		"directory": "packages/evals"
	},
	"homepage": "https://github.com/kunwarVivek/pi-agentic#readme",
	"bugs": {
		"url": "https://github.com/kunwarVivek/pi-agentic/issues"
	},
	"keywords": [
		"agentic-pi",
		"evals"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc --build",
		"typecheck": "tsc --noEmit",
		"prepack": "tsc --build"
	},
	"dependencies": {
		"pi-agentic-core": "0.1.0",
		"pi-agentic-control-plane": "0.1.0"
	}
}
