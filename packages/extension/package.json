{
	"name": "pi-agentic",
	"version": "0.1.1",
	"description": "Pi extension that turns a session into a governed agentic-org unit: default-deny, audited tool policy; bubblewrap-sandboxed bash; secret redaction; budget metering with escalation; org delegate/complete/escalate tools; manifest-listed project trust.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kunwarVivek/pi-agentic.git",
		"directory": "packages/extension"
	},
	"homepage": "https://github.com/kunwarVivek/pi-agentic#readme",
	"bugs": {
		"url": "https://github.com/kunwarVivek/pi-agentic/issues"
	},
	"keywords": [
		"agentic-pi",
		"pi-package",
		"pi-extension",
		"policy",
		"audit"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./shared": {
			"development": "./src/shared.ts",
			"types": "./dist/shared.d.ts",
			"default": "./dist/shared.js"
		}
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"scripts": {
		"build": "tsc --build",
		"typecheck": "tsc --noEmit",
		"prepack": "tsc --build"
	},
	"dependencies": {
		"pi-agentic-core": "0.1.1",
		"pi-agentic-control-plane": "0.1.1",
		"pi-agentic-deploy": "0.1.1"
	}
}
